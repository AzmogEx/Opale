# --- Opale — variables d'environnement (exemple) ---
# Copier en `.env` et adapter. Ne jamais committer `.env` (secrets hors code, §16).

# ── Serveur ───────────────────────────────────────────────────────────────────
OPALE_HTTP_ADDR=:8080
OPALE_ENV=dev                       # dev | prod
OPALE_LOG_LEVEL=info                # debug | info | warn | error

# ── Base de données PostgreSQL ────────────────────────────────────────────────
OPALE_DB_HOST=localhost
OPALE_DB_PORT=5432                  # port exposé sur 127.0.0.1 par Compose
OPALE_DB_USER=opale
OPALE_DB_PASSWORD=changeme-en-prod
OPALE_DB_NAME=opale
OPALE_DB_SSLMODE=disable            # disable en local, require en prod
# Alternative : URL complète (prioritaire si renseignée)
# OPALE_DATABASE_URL=postgres://opale:changeme@localhost:5432/opale?sslmode=disable

# ── Sécurité ──────────────────────────────────────────────────────────────────
OPALE_SESSION_TTL=720h              # durée de validité d'une session (Go duration)

# ── Coffre-fort (EF-064) — chiffrement AES-256-GCM des documents ─────────────
# 64 caractères hexadécimaux (32 octets). Générer : openssl rand -hex 32
# ⚠️ À SAUVEGARDER précieusement : clé perdue = documents illisibles.
OPALE_VAULT_KEY=

# ── IA en cascade (P5) — chaque niveau est optionnel ─────────────────────────
# N2 : serveur Ollama du homelab (RTX 5080). Vide = niveau désactivé.
OPALE_OLLAMA_URL=                   # ex. http://192.168.1.50:11434
OPALE_OLLAMA_MODEL=llama3.1:8b
# Cloud facultatif : intention structurée et agrégats minimisés ; jamais la question libre ni les identifiants.
OPALE_ANTHROPIC_API_KEY=
OPALE_CLOUD_AI=off                   # off = interdit le cloud même avec une clé

# ── Synchro bancaire GoCardless (EF-071) — optionnel ─────────────────────────
# Compte gratuit : https://bankaccountdata.gocardless.com
OPALE_GC_SECRET_ID=
OPALE_GC_SECRET_KEY=
# OPALE_GC_BASE_URL=                # surcharge pour les tests (mock)

# ── CORS (clients web sur une autre origine) ─────────────────────────────────────────────────────
# Origines autorisées, séparées par des virgules. Vide = désactivé.
# OPALE_CORS_ORIGINS=https://opale.mondomaine.fr

# ── Cours automatiques (OPT-IN) ───────────────────────────────────────────────
# on = le serveur rafraîchit chaque jour les taux BCE (devises déjà saisies)
# et les cryptos suivies via CoinGecko. Les requêtes sortantes ne contiennent
# que des symboles publics (« bitcoin ») — aucune donnée personnelle.
OPALE_AUTO_QUOTES=off

# ── Notifications push APNs (optionnel) ───────────────────────────────────────
# Clé « Auth Key » (.p8) créée sur developer.apple.com → Keys (APNs coché).
# Tout vide = push désactivé (les alertes restent visibles dans l'app).
# OPALE_APNS_KEY_PATH=/chemin/vers/AuthKey_XXXXXXXXXX.p8
# OPALE_APNS_KEY_ID=XXXXXXXXXX        # l'identifiant de la clé
# OPALE_APNS_TEAM_ID=X3G9BWSS83       # le Team ID Apple Developer
# OPALE_APNS_BUNDLE_ID=app.opale.ios
# OPALE_APNS_ENV=sandbox              # sandbox (build Xcode) | production (TestFlight/App Store)

# Ports Docker exposés uniquement sur la boucle locale
OPALE_API_PORT=8080
OPALE_WEB_PORT=3000
# Compose transmet le contenu PEM ; pour un fichier, monter un secret + OPALE_APNS_KEY_PATH via override.
# OPALE_APNS_KEY_P8=

# Reverse proxy HTTPS optionnel (docker-compose.https.yml) : domaine DNS pointant sur l’hôte.
# OPALE_DOMAIN=opale.exemple.fr
